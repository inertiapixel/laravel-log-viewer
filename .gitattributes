* text=auto eol=lf

# Compiled assets ship with the package; mark them as generated for diffs.
/resources/dist/** linguist-generated=true -diff

# Exclude development-only files from Composer dist archives.
/.github              export-ignore
/tests                export-ignore
/build.mjs            export-ignore
/package.json         export-ignore
/package-lock.json    export-ignore
/playwright.config.js export-ignore
/phpunit.xml.dist     export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
