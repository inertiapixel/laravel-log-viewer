{
    "name": "inertiapixel/laravel-log-viewer",
    "description": "InertiaPixel Laravel Log Viewer: a secure, read-only log dashboard for Laravel with search, filters, date ranges and charts. No npm or build step required.",
    "keywords": [
        "laravel",
        "logs",
        "log-viewer",
        "monolog",
        "dashboard",
        "inertiapixel"
    ],
    "homepage": "https://github.com/inertiapixel/laravel-log-viewer",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "InertiaPixel",
            "homepage": "https://github.com/inertiapixel"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "InertiaPixel\\LaravelLogViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InertiaPixel\\LaravelLogViewer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InertiaPixel\\LaravelLogViewer\\LogViewerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
